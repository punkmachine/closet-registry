{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# closet-cli и healthcheck ходят сюда. Bearer-токен проверяет сам API.
	handle /health {
		reverse_proxy api:3000
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	# Админка: вход через собственную страницу /login (cookie-сессия), Basic Auth не нужен.
	handle {
		reverse_proxy admin:3000
	}
}
