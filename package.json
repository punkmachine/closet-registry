{
  "name": "closet-registry-monorepo",
  "version": "0.1.0",
  "description": "Монорепо self-hosted реестра плагинов для closet-cli: HTTP-API (apps/registry) и веб-админка (apps/admin-panel)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/*\" dev",
    "dev:registry": "pnpm build:packages && pnpm --filter @closet/registry dev",
    "dev:admin": "pnpm build:packages && pnpm --filter @closet/admin-panel dev",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm build:packages && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm build:packages && tsc --noEmit -p tsconfig.json && pnpm --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project contract --project registry-unit --project admin-unit",
    "test:api": "vitest run --project registry-api",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migration:run": "pnpm --filter @closet/registry migration:run",
    "migration:revert": "pnpm --filter @closet/registry migration:revert",
    "prepare": "simple-git-hooks",
    "codemod:strip-comments": "tsx scripts/codemods/strip-comments.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/compiler-sfc": "^3.5.43",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.2.2",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "jiti": "^2.7.0",
    "nano-staged": "^1.0.2",
    "oxc-parser": "^0.153.0",
    "postcss": "^8.5.29",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.11",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vitest": "catalog:",
    "vue": "^3.5.43"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged",
    "pre-push": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "nano-staged": {
    "*.{ts,vue,json,css}": "biome check --write --no-errors-on-unmatched",
    "*.ts": "eslint --fix"
  },
  "packageManager": "pnpm@11.17.0"
}
