{
  "name": "closet-ai-registry",
  "version": "0.1.0",
  "description": "Публичный read-only HTTP API поверх каталога items (rules/skills/commands/agents/hooks/mcp/statusline) для closet-ai, плюс admin write-эндпоинты и статистика установок",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate -j ts -m src/db/migrations",
    "migrate:create": "node-pg-migrate -j ts -m src/db/migrations create",
    "seed": "tsx scripts/seed-fixtures.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/semver": "^7.5.8",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0"
}
