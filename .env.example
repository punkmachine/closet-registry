# Секреты. Скрипт ./up.sh заполнит пустые сам — руками ничего генерировать не нужно.

# Первый admin создаётся при старте API, если в базе ещё нет ни одного. Пароль: минимум 9 символов и
# спецсимвол. Позже меняется только через админку — правка .env существующего admin не затрагивает.
ADMIN_USERNAME=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# Только для ./up.sh --tls (свой домен + HTTPS)
DOMAIN=registry.example.com
ACME_EMAIL=

# --- ниже только если разрабатываешь сами приложения (pnpm dev) ---

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/closet_registry
PORT=3000
REGISTRY_URL=http://127.0.0.1:3000
