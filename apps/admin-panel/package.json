{
  "name": "@closet/admin-panel",
  "version": "0.1.0",
  "description": "Веб-админка closet-registry: список плагинов, просмотр файлов версии, публикация, редактирование и удаление",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev --port 3001 --dotenv ../../.env",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --root ../.. --project admin-unit"
  },
  "dependencies": {
    "@closet/contract": "workspace:*",
    "@closet/ui": "workspace:*",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@closet/config": "workspace:*",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.11"
  }
}
