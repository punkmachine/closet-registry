{
  "name": "@closet/registry",
  "version": "0.1.0",
  "description": "Self-hosted HTTP-реестр плагинов (mcp/rules/hooks/agents/commands/skills/scripts) для closet-cli: bundle-чтение версий, admin write-эндпоинты и статистика установок",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migration:run": "tsx --conditions=development src/db/run-migrations.ts",
    "migration:revert": "tsx --conditions=development src/db/revert-migration.ts",
    "test": "vitest run --root ../.. --project registry-unit --project registry-api",
    "test:unit": "vitest run --root ../.. --project registry-unit",
    "test:api": "vitest run --root ../.. --project registry-api"
  },
  "dependencies": {
    "@closet/contract": "workspace:*",
    "@closet/harness-render": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.5",
    "typeorm": "^1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@closet/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.21.0",
    "@types/semver": "^7.5.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
